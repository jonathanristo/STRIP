#!/usr/bin/env bash
set -euo pipefail

STRIP_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STRIP_VERSION="$(cat "$STRIP_HOME/VERSION" 2>/dev/null || echo unknown)"
# version is answerable without yq/docker/config, so short-circuit early
[[ "${1:-}" == "version" || "${1:-}" == "--version" || "${1:-}" == "-v" ]] && { echo "STRIP v$STRIP_VERSION"; exit 0; }
CFG="$STRIP_HOME/strip.yaml"
OUTROOT="$(yq -r '.output.root' "$CFG")"
SCAN_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"   # ISO 8601 UTC — record timestamp / scan_id (TR-004)
# run-dir keeps the original YYYYMMDD-HHMMSS format (UTC, derived from SCAN_TS) so nothing parsing
# directory names breaks — TR-004 only requires ISO 8601 on the record fields, not the dir.
TS="$(d=${SCAN_TS%%T*}; t=${SCAN_TS#*T}; t=${t%Z}; echo "${d//-/}-${t//:/}")"
DATA_DIR="${DATA_DIR:-$(pwd)/data}"
OUT="$STRIP_HOME/${OUTROOT#./}/$TS"
mkdir -p "$OUT"

compose(){ docker compose -f "$STRIP_HOME/docker-compose.yml" "$@"; }
yqg(){ yq -r "$1" "$CFG"; }
log(){ echo "[STRIP $(date +%H:%M:%S)] $*"; }
need(){ [[ -f "$1" ]] || { echo "Missing $1"; exit 1; }; }

setup() {
  echo "═══════════════════════════════════════════════"
  echo "  STRIP Initial Setup"
  echo "═══════════════════════════════════════════════"
  echo ""
  
  # Create Docker volume for templates
  log "Creating Docker volume for Nuclei templates..."
  docker volume create nuclei-templates 2>/dev/null || true
  
  # Create local directories for output
  log "Creating output directories..."
  mkdir -p "$DATA_DIR/out"
  
  # Download Nuclei templates to Docker volume
  log "Downloading Nuclei vulnerability templates..."
  log "This may take 2-5 minutes on first run..."
  echo ""
  
  docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    projectdiscovery/nuclei:latest \
    -update-templates
  
  # Verify templates were downloaded
  TEMPLATE_COUNT=$(docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    alpine:latest \
    find /root/nuclei-templates -name "*.yaml" 2>/dev/null | wc -l | tr -d ' ')
  
  if [ "$TEMPLATE_COUNT" -gt 1000 ]; then
    echo ""
    log "✓ Setup complete!"
    log "Templates installed: $TEMPLATE_COUNT templates"
    log "Storage: Docker volume 'nuclei-templates' (isolated from host)"
    echo ""
    echo "Next steps:"
    echo "  ./stripctl discover     # Discover targets"
    echo "  ./stripctl run daily    # Run daily scan"
    echo ""
  else
    echo ""
    echo "[ERR] Setup failed - only $TEMPLATE_COUNT templates found"
    echo "Expected 10,000+ templates"
    exit 1
  fi
}

ensure_nuclei_templates() {
  # Check if Docker volume exists
  if ! docker volume inspect nuclei-templates >/dev/null 2>&1; then
    log "⚠ Nuclei templates volume not found"
    log "Running first-time setup..."
    echo ""
    setup
    return
  fi
  
  # Check if volume has templates
  TEMPLATE_COUNT=$(docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    alpine:latest \
    find /root/nuclei-templates -name "*.yaml" 2>/dev/null | wc -l | tr -d ' ')
  
  if [ "$TEMPLATE_COUNT" -lt 1000 ]; then
    log "⚠ Nuclei templates incomplete ($TEMPLATE_COUNT templates)"
    log "Running setup to download templates..."
    echo ""
    setup
  else
    log "✓ Nuclei templates found ($TEMPLATE_COUNT templates)"
  fi
}

discover(){
  local domains="$STRIP_HOME/$(yqg '.inputs.domains_file' | sed 's#^\./##')"
  local resolv="$STRIP_HOME/$(yqg '.inputs.resolvers_file' | sed 's#^\./##')"
  need "$domains"
  log "Output → $OUT"
  cp "$domains" "$OUT/domains.txt"

  # ── Classify inputs: domain | IP | CIDR ───────────────────────────────────
  : > "$OUT/in_domains.txt"; : > "$OUT/in_ips.txt"; : > "$OUT/in_cidrs.txt"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -z "$line" ]] && continue
    if   [[ "$line" == */* ]]; then printf '%s\n' "$line" >> "$OUT/in_cidrs.txt"     # IPv4/IPv6 CIDR
    elif [[ "$line" == *:* ]]; then printf '%s\n' "$line" >> "$OUT/in_ips.txt"       # IPv6 literal
    elif [[ "$line" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then printf '%s\n' "$line" >> "$OUT/in_ips.txt"  # IPv4
    else printf '%s\n' "$line" >> "$OUT/in_domains.txt"                              # domain
    fi
  done < "$OUT/domains.txt"
  log "inputs → domains:$(wc -l <"$OUT/in_domains.txt"|tr -d ' ') ips:$(wc -l <"$OUT/in_ips.txt"|tr -d ' ') cidrs:$(wc -l <"$OUT/in_cidrs.txt"|tr -d ' ')"

  # ── Subdomain discovery + DNS resolution (domains only) ───────────────────
  : > "$OUT/hosts_resolved.txt"
  if [[ -s "$OUT/in_domains.txt" ]]; then
    log "subfinder…"
    compose run --rm subfinder -dL "/data/out/$TS/in_domains.txt" -all -silent -o "/data/out/$TS/subs.subfinder.txt" || true
    if [[ "${1:-}" == "sweep" ]]; then
      log "amass (passive, sweep)…"
      compose run --rm amass enum -norecursive -passive -df "/data/out/$TS/in_domains.txt" -o "/data/out/$TS/subs.amass.txt" || true
    fi
    # include apex domains + all sub sources (subs.*.txt = subfinder [+ amass]) so nothing is dropped
    cat "$OUT"/subs.*.txt "$OUT/in_domains.txt" 2>/dev/null | sort -u > "$OUT/subs.txt"

    if [[ -f "$resolv" ]]; then
      log "dnsx (custom resolvers)…"
      resopts=()
      while read -r r; do
        r="${r%$'\r'}"   # tolerate CRLF (Windows-edited resolvers.txt)
        [[ -n "$r" && "$r" != \#* ]] && resopts+=(-r "$r")
      done < "$resolv"
      compose run --rm dnsx -l "/data/out/$TS/subs.txt" "${resopts[@]}" -a -o "/data/out/$TS/resolved.txt" || true
    else
      log "dnsx…"
      compose run --rm dnsx -l "/data/out/$TS/subs.txt" -a -o "/data/out/$TS/resolved.txt" || true
    fi
    [[ -s "$OUT/resolved.txt" ]] && cut -d' ' -f1 "$OUT/resolved.txt" | sort -u > "$OUT/hosts_resolved.txt"
  else
    log "no domains in input — skipping subfinder + dnsx"
  fi

  # ── Combined scan targets: resolved hosts + literal IPs + CIDRs ────────────
  cat "$OUT/hosts_resolved.txt" "$OUT/in_ips.txt" "$OUT/in_cidrs.txt" 2>/dev/null | sort -u > "$OUT/scan_targets.txt"
  if [[ ! -s "$OUT/scan_targets.txt" ]]; then
    log "no scan targets — nothing to scan"; return 0
  fi

  log "naabu ports (top)…"
  compose run --rm naabu -list "/data/out/$TS/scan_targets.txt" -top-ports "$(yqg '.scan.naabu.top_ports')" --rate "$(yqg '.scan.naabu.rate')" -silent -o "/data/out/$TS/ports.naabu.txt" || true

  log "nmap follow-up (light -sV)…"
  awk -F: '{print $1}' "$OUT/ports.naabu.txt" 2>/dev/null | sort -u > "$OUT/hosts_for_nmap.txt"
  [[ -s "$OUT/hosts_for_nmap.txt" ]] && compose run --rm nmap nmap -sV --version-light -T3 -iL "/data/out/$TS/hosts_for_nmap.txt" --top-ports 20 -oX "/data/out/$TS/nmap.xml" || true

  log "httpx (title/tech)…"
  # build URLs preserving the discovered port (host may be IPv4/hostname or [IPv6]); split on last colon
  awk -F: 'NF>=2 { port=$NF; host=substr($0,1,length($0)-length($NF)-1);
                   if (host!="" && port ~ /^[0-9]+$/) { print "http://"host":"port; print "https://"host":"port } }' \
    "$OUT/ports.naabu.txt" 2>/dev/null | sort -u > "$OUT/urls.txt"
  [[ -s "$OUT/urls.txt" ]] && compose run --rm httpx \
    -l "/data/out/$TS/urls.txt" \
    -json -silent -status-code -title -tech-detect \
    -o "/data/out/$TS/httpx.json" || true

  # ── Crawl (sweep only): expand the URL surface so nuclei tests more than site roots ──
  if [[ "${1:-}" == "sweep" && "$(yqg '.scan.katana.enable')" == "true" && -s "$OUT/httpx.json" ]]; then
    local jc=""
    [[ "$(yqg '.scan.katana.js_crawl')" == "true" ]] && jc="-jc" || true
    jq -r '.url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/httpx_live.txt"
    log "katana (crawl, depth $(yqg '.scan.katana.depth'))…"
    compose run --rm katana -list "/data/out/$TS/httpx_live.txt" -d "$(yqg '.scan.katana.depth')" $jc -silent -o "/data/out/$TS/katana.txt" || true
    if [[ -s "$OUT/katana.txt" ]]; then
      cat "$OUT/urls.txt" "$OUT/katana.txt" 2>/dev/null | sort -u > "$OUT/urls.all.txt" && mv "$OUT/urls.all.txt" "$OUT/urls.txt"
      log "katana: url surface expanded to $(wc -l <"$OUT/urls.txt"|tr -d ' ')"
    fi
  fi

  log "[✓] STRIP discovery complete."
}

webscan(){
  local sev="${1:-$(yqg '.scan.nuclei.severity_daily')}"
  log "nuclei HTTP (severity: $sev)…"
  compose run --rm nuclei -stats -rl "$(yqg '.scan.nuclei.rate_limit')" -c "$(yqg '.scan.nuclei.concurrency')" \
    -severity "$sev" -ni -jsonl -l "/data/out/$TS/urls.txt" -o "/data/out/$TS/nuclei.jsonl" || true

  if [[ "$(yqg '.scan.tls.sslyze')" == "true" ]]; then
    log "sslyze…"
    compose run --rm sslyze --json_out "/data/out/$TS/sslyze.json" --targets_in "/data/out/$TS/urls.txt" || true
  fi
  log "[✓] Web/TLS done."
}

tls(){
  [[ "$(yqg '.scan.tls.testssl')" == "true" ]] || { log "testssl disabled"; return 0; }
  # Assess live HTTPS services only (skip plain http); derived from httpx output
  if [[ -s "$OUT/httpx.json" ]]; then
    jq -r 'select(.scheme=="https") | .url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/https_urls.txt" || true
  fi
  if [[ ! -s "$OUT/https_urls.txt" ]]; then
    log "testssl: no HTTPS services found — skipping"
    return 0
  fi
  local n; n="$(wc -l < "$OUT/https_urls.txt" | tr -d ' ')"
  log "testssl (TLS assessment, --fast) on $n target(s)…"
  compose run --rm testssl --fast --warnings batch \
    --file "/data/out/$TS/https_urls.txt" \
    --jsonfile "/data/out/$TS/testssl.json" || true
  log "[✓] testssl done."
}

shots(){
  [[ "$(yqg '.screenshots.enable')" == "true" ]] || { log "screenshots disabled"; return 0; }
  [[ -s "$OUT/httpx.json" ]] || { log "shots: no live web services — skipping"; return 0; }
  jq -r '.url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/shot_urls.txt"
  [[ -s "$OUT/shot_urls.txt" ]] || { log "shots: no urls — skipping"; return 0; }
  mkdir -p "$OUT/screenshots"
  log "gowitness (screenshots)…"
  compose run --rm gowitness scan file \
    -f "/data/out/$TS/shot_urls.txt" \
    --screenshot-path "/data/out/$TS/screenshots" \
    --write-jsonl --write-jsonl-file "/data/out/$TS/gowitness.jsonl" \
    --threads "$(yqg '.screenshots.gowitness.workers')" \
    --delay "$(yqg '.screenshots.gowitness.delay')" || true
  log "[✓] screenshots done."
}

merge(){
  local R="$OUT"
  log "Merging outputs…"

  # url→screenshot lookup from the gowitness manifest (empty object if none)
  if [[ -s "$R/gowitness.jsonl" ]]; then
    jq -s 'map(select(.url) | {(.url): ("screenshots/" + (.file_name // .screenshot // ""))}) | add // {}' \
      "$R/gowitness.jsonl" > "$R/.shots_map.json" 2>/dev/null || echo '{}' > "$R/.shots_map.json"
  else
    echo '{}' > "$R/.shots_map.json"
  fi

  # resolvable-hostname set for TR-004 hostname_resolvable (from dnsx output)
  local RES_MAP='{}'
  if [[ -s "$R/resolved.txt" ]]; then
    RES_MAP="$(cut -d' ' -f1 "$R/resolved.txt" | sort -u | jq -R . | jq -cs 'map({(.):true}) | add // {}')" || RES_MAP='{}'
  fi

  # ── web_assets.ndjson (httpx) — TR-004 provenance ─────────────────────────
  [[ -s "$R/httpx.json" ]] && \
  jq -c --argjson shots "$(cat "$R/.shots_map.json")" --argjson resolved "$RES_MAP" '
    (.host // "") as $h
    | (($h|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h|test(":"))) as $hisip
    | { source_module: "STRIP",
      source_tool:   "httpx",
      scan_id:       "'"$SCAN_TS"'",
      observed_at:   "'"$SCAN_TS"'",
      fqdn:          (.url // ""),
      hostname_at_observation_time: (if ($h=="" or $hisip) then null else $h end),
      hostname_resolvable:          (if $hisip then false else ($resolved[$h] // false) end),
      ip_at_observation_time:       (.input // .ip // ""),
      status: (.status_code // 0),
      title:  (.title // ""),
      tech:
        ( (.tech // .technologies // "")
          | if type=="string" then (if .=="" then [] else (split(",")|map(ascii_downcase)) end)
            elif type=="array" then (map(tostring|ascii_downcase))
            else [] end ),
      screenshot: ($shots[(.url // "")] // "")
    }' "$R/httpx.json" > "$R/web_assets.ndjson" || true

  # ── services.ndjson (naabu + nmap) — TR-004 provenance ────────────────────
  : > "$R/.services.raw.ndjson"
  if [[ -f "$R/ports.naabu.txt" ]]; then
    awk -F: 'NF>=2 { port=$NF; host=substr($0,1,length($0)-length($NF)-1); gsub(/["\\]/,"",host);
                     printf("{\"tool\":\"naabu\",\"target\":\"%s\",\"port\":%s}\n", host, port) }' \
      "$R/ports.naabu.txt" >> "$R/.services.raw.ndjson"
  fi
  if [[ -f "$R/nmap.xml" ]]; then
    # containerized XML parse (stdlib, no host xmlstarlet) — keeps service/product/version separate
    compose run --rm xmlparse python3 -c '
import sys, json, xml.etree.ElementTree as ET
try:
    root = ET.parse(sys.argv[1]).getroot()
except Exception:
    sys.exit(0)
for host in root.findall("host"):
    ip = ""
    for a in host.findall("address"):
        if a.get("addrtype") in ("ipv4", "ipv6"):
            ip = a.get("addr", "")
    for p in host.findall(".//port"):
        st = p.find("state")
        if st is None or st.get("state") != "open":
            continue
        s = p.find("service")
        name = s.get("name", "") if s is not None else ""
        prod = s.get("product", "") if s is not None else ""
        ver = s.get("version", "") if s is not None else ""
        print(json.dumps({"tool": "nmap", "target": ip,
                          "port": int(p.get("portid", "0") or 0),
                          "service": name, "product": prod, "version": ver}))
' "/data/out/$TS/nmap.xml" 2>/dev/null >> "$R/.services.raw.ndjson" || true
  fi
  [[ -s "$R/.services.raw.ndjson" ]] && \
  jq -c -R --argjson resolved "$RES_MAP" '
    fromjson? | select(.)
    | (.target) as $t
    | (($t|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($t|test(":"))) as $isip
    | { source_module: "STRIP",
        source_tool:   .tool,
        scan_id:       "'"$SCAN_TS"'",
        observed_at:   "'"$SCAN_TS"'",
        hostname_at_observation_time: (if $isip then null else $t end),
        hostname_resolvable:          (if $isip then false else ($resolved[$t] // false) end),
        ip_at_observation_time:       (if $isip then $t else "" end),
        port:    .port,
        service: (.service // ""),
        product: (.product // ""),
        version: (.version // "")
      }' "$R/.services.raw.ndjson" > "$R/services.ndjson" || true

  # ── findings.ndjson (nuclei + testssl) — TR-004 provenance ────────────────
  { [[ -s "$R/nuclei.jsonl" ]] && jq -c -R 'fromjson? | select(.)' "$R/nuclei.jsonl"; } \
  | jq -c --argjson resolved "$RES_MAP" '
      (.host // "") as $h
      | (($h|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h|test(":"))) as $hisip
      | { source_module: "STRIP",
        source_tool:   "nuclei",
        scan_id:       "'"$SCAN_TS"'",
        observed_at:   "'"$SCAN_TS"'",
        hostname_at_observation_time: (if ($h=="" or $hisip) then null else $h end),
        hostname_resolvable:          (if $hisip then false else ($resolved[$h] // false) end),
        ip_at_observation_time:       (.ip // .host // ""),
        url:      .url,
        template: (.templateID),
        finding:  null,
        severity: ((.severity // "info") | ascii_downcase),
        name:     (.info.name),
        evidence: (.matcher_name // .["matcher-status"]),
        raw: .
      }' > "$R/findings.ndjson" 2>/dev/null || true

  [[ -s "$R/testssl.json" ]] && \
  jq -c --argjson resolved "$RES_MAP" '
    (if type=="object" and has("scanResult") then .scanResult else . end)
    | (if type=="array" then .[] else . end)
    | select(type=="object")
    | ((.ip // "") | tostring | split("/")) as $hi
    | ($hi[0] // "") as $h0
    | (($h0|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h0|test(":"))) as $h0isip
    | (($hi|length) > 1 and ($h0isip | not)) as $hasname
    | { source_module: "STRIP",
        source_tool:   "testssl",
        scan_id:       "'"$SCAN_TS"'",
        observed_at:   "'"$SCAN_TS"'",
        hostname_at_observation_time: (if $hasname then $h0 else null end),
        hostname_resolvable:          (if $hasname then ($resolved[$h0] // false) else false end),
        ip_at_observation_time:       ($hi[-1] // ""),
        url:      null,
        template: null,
        finding:  (.finding // .id // ""),
        severity: ((.severity // "info") | ascii_downcase),
        name:     (.finding // .id // ""),
        evidence: null,
        raw: .
      }
    | select(.severity | IN("low","medium","high","critical"))
  ' "$R/testssl.json" >> "$R/findings.ndjson" 2>/dev/null || true

  # ── CSV exports (human-readable) ──────────────────────────────────────────
  [[ -s "$R/web_assets.ndjson" ]] && jq -r '[.fqdn,.hostname_at_observation_time,.ip_at_observation_time,.status,.title]|@csv' "$R/web_assets.ndjson" > "$R/web_assets.csv" || true
  [[ -s "$R/services.ndjson"   ]] && jq -r '[(.hostname_at_observation_time // .ip_at_observation_time),.port,.service,.product,.version]|@csv' "$R/services.ndjson" > "$R/open_ports.csv" || true
  [[ -s "$R/findings.ndjson"   ]] && jq -r '[(.hostname_at_observation_time // .ip_at_observation_time),(.url // ""),.severity,(.template // .finding),.source_tool]|@csv' "$R/findings.ndjson" > "$R/findings_summary.csv" || true

  # sentinel so an empty findings file is distinguishable from a failed merge (BACKSTAGE skips it)
  if [[ ! -s "$R/findings.ndjson" ]]; then
    echo "{\"source_module\":\"STRIP\",\"scan_id\":\"$SCAN_TS\",\"observed_at\":\"$SCAN_TS\",\"message\":\"No findings from this run\"}" > "$R/findings.ndjson"
  fi

  log "[✓] Merge complete → $R"
}

usage(){
  cat <<USAGE
STRIP v$STRIP_VERSION — Surface Threat Reconnaissance & Identification Platform

Setup (first time only):
  stripctl setup                  # Download Nuclei templates to Docker volume

Discovery & Scanning:
  stripctl discover               # Full reconnaissance (subdomains → DNS → ports → HTTP)
  stripctl run daily              # Complete daily scan (discover + nuclei + screenshots)
  stripctl run weekly             # Comprehensive weekly scan (includes medium severity)

Additional:
  stripctl merge                  # Consolidate scan results into reports
  stripctl version                # Print the STRIP version

Examples:
  # First time setup (optional - auto-runs if templates missing)
  ./stripctl setup

  # Discover targets
  ./stripctl discover

  # Daily monitoring scan
  ./stripctl run daily

  # Weekly comprehensive scan
  ./stripctl run weekly

Output: data/out/YYYYMMDD-HHMMSS/

Notes:
  - Templates stored securely in Docker volume (not on host filesystem)
  - Templates auto-download on first 'run daily' or 'run weekly' if missing
  - 'discover' can be run standalone for manual analysis
  - 'run daily/weekly' includes full workflow (discover + scan + screenshots)
USAGE
}

case "${1:-}" in
  setup) 
    setup 
    ;;
  discover) 
    discover 
    ;;
  run)
    case "${2:-}" in
      daily)  
        ensure_nuclei_templates
        discover
        webscan "$(yqg '.scan.nuclei.severity_daily')"
        tls
        shots
        merge
        ;;
      weekly)
        ensure_nuclei_templates
        discover sweep
        webscan "$(yqg '.scan.nuclei.severity_weekly')"
        tls
        shots
        merge
        ;;
      *) 
        usage 
        ;;
    esac 
    ;;
  merge)
    merge 
    ;;
  *) 
    usage 
    ;;
esac
