#!/usr/bin/env bash
set -euo pipefail

STRIP_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STRIP_VERSION="$(cat "$STRIP_HOME/VERSION" 2>/dev/null || echo unknown)"
# version is answerable without yq/docker/config, so short-circuit early
[[ "${1:-}" == "version" || "${1:-}" == "--version" || "${1:-}" == "-v" ]] && { echo "STRIP v$STRIP_VERSION"; exit 0; }
CFG="$STRIP_HOME/strip.yaml"
OUTROOT="$(yq -r '.output.root' "$CFG")"
SCAN_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"   # ISO 8601 UTC — record timestamp / scan_id (TR-004)
# run-dir keeps the original YYYYMMDD-HHMMSS format (UTC, derived from SCAN_TS) so nothing parsing
# directory names breaks — TR-004 only requires ISO 8601 on the record fields, not the dir.
TS="$(d=${SCAN_TS%%T*}; t=${SCAN_TS#*T}; t=${t%Z}; echo "${d//-/}-${t//:/}")"
START_EPOCH="$(date +%s)"                    # run start (for run_manifest duration_seconds)
DATA_DIR="${DATA_DIR:-$(pwd)/data}"
OUT="$STRIP_HOME/${OUTROOT#./}/$TS"
# don't create a run dir when sourced for tests (STRIP_TEST_MODE=1) — tests only want the functions
[[ "${STRIP_TEST_MODE:-0}" == "1" ]] || mkdir -p "$OUT"

compose(){ docker compose -f "$STRIP_HOME/docker-compose.yml" "$@"; }
# Run a containerized tool: -T (no pseudo-TTY) + stdin from /dev/null. The ProjectDiscovery tools
# (dnsx/subfinder/naabu/httpx/nuclei/katana) read stdin, and `docker compose run` leaves stdin
# attached as an idle, never-closed pipe when output is redirected or the run is non-interactive
# (cron) — so they block forever waiting for EOF. Feeding /dev/null gives them an immediate EOF.
# Every STRIP tool takes file/flag input, so none of them need a real stdin.
crun(){ compose run --rm -T "$@" </dev/null; }
yqg(){ yq -r "$1" "$CFG"; }
log(){ echo "[STRIP $(date +%H:%M:%S)] $*"; }
need(){ [[ -f "$1" ]] || { echo "Missing $1"; exit 1; }; }
# newest run dir under OUTROOT that actually holds tool output — lets a standalone `merge` normalize
# the real run instead of the empty timestamp dir this invocation just created at startup
latest_run_dir(){
  local root="$STRIP_HOME/${OUTROOT#./}" d
  # sort by NAME (run dirs are YYYYMMDD-HHMMSS) not mtime — re-merging an old run bumps its mtime but
  # must not make it "newest". A dir counts as a real run if discovery copied its input (domains.txt)
  # OR any tool produced output — so a valid zero-result run still merges (into sentinels); the empty
  # startup dir a standalone `merge` just created has none of these and is skipped.
  for d in $(ls -1d "$root"/*/ 2>/dev/null | sort -r); do
    d="${d%/}"
    [[ -s "$d/domains.txt" || -s "$d/ports.naabu.txt" || -s "$d/resolved.json" || -s "$d/httpx.json" || -s "$d/nuclei.jsonl" ]] \
      && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}

# ── pure parsers (no side effects; stdin→stdout) — unit-tested in tests/parsers ────────────────────
# host:port → "host<TAB>port", splitting on the LAST colon so IPv6 literals survive; strip [] and
# drop non-numeric ports.
sp_split_hostports(){
  awk -F: 'NF>=2 { port=$NF; host=substr($0,1,length($0)-length($NF)-1); gsub(/[][]/,"",host);
                   if (host!="" && port ~ /^[0-9]+$/) print host"\t"port }'
}
# host:port → http:// and https:// URLs, bracketing IPv6 literals as [addr]:port.
sp_urls_from_hostports(){
  awk -F: 'NF>=2 { port=$NF; host=substr($0,1,length($0)-length($NF)-1); gsub(/[][]/,"",host);
                   if (host!="" && port ~ /^[0-9]+$/) { h=(host ~ /:/)?"["host"]":host;
                   print "http://"h":"port; print "https://"h":"port } }'
}
# resolver file → cleaned list: strip CR, inline #comments, all whitespace, and blank lines.
sp_clean_resolvers(){
  sed -e 's/\r$//' -e 's/#.*//' -e 's/[[:space:]]//g' | grep -v '^$' || true
}
# host list → nmap targets for one address family ($1 = 4|6): IP literals of that family PLUS all
# hostnames (a hostname resolves to the right family per run), sorted-unique.
sp_nmap_hosts(){
  local fam="${1:-4}" all names
  all="$(cat)"
  names="$(printf '%s\n' "$all" | grep -vE '^[0-9.]+$|:' || true)"   # hostnames (not IP literals)
  { if [[ "$fam" == 6 ]]; then printf '%s\n' "$all" | grep ':' || true
    else printf '%s\n' "$all" | grep -E '^[0-9.]+$' || true; fi
    printf '%s\n' "$names"; } | grep -v '^$' | sort -u || true
}
# httpx JSON (NDJSON on stdin) → nuclei target URLs: the live services httpx confirmed, ONE per
# host:port (preferring https over http). NOT the raw naabu http×https×port cross-product, which
# includes dead scheme/port mismatches that only error against WAFs/CDNs and multiply the scan time.
sp_nuclei_targets(){
  jq -r 'select((.failed//false)|not) | "\(.host // "")|\(.port // "")\t\(.scheme // "http")\t\(.url // "")"' 2>/dev/null \
    | awk -F'\t' 'NF>=3 && $3!="" {
        if (!($1 in url) || ($2=="https" && sch[$1]!="https")) { url[$1]=$3; sch[$1]=$2 } }
       END { for (k in url) print url[k] }' \
    | sort -u
}
# nuclei's target list for a run dir ($1): httpx-VALIDATED live services (sp_nuclei_targets) plus any
# katana-crawled URLs (sweep), deduped. It deliberately NEVER reads urls.txt — that raw cross-product
# is unvalidated. Empty output means "nothing live" (httpx found nothing OR never ran) → caller skips.
sp_nuclei_target_list(){
  local d="$1"
  { [[ -s "$d/httpx.json" ]] && sp_nuclei_targets < "$d/httpx.json"
    [[ -s "$d/katana.txt" ]] && cat "$d/katana.txt"
    true; } 2>/dev/null | sort -u
}
# email-posture assessment: reads a run dir's in_domains.txt + email_txt.json + email_caa.json and
# emits email_security FINDINGS (absences/weaknesses) as findings.ndjson lines. Pure host-jq logic,
# unit-tested in tests/parsers. The records themselves (facts) go into dns.ndjson via merge. DKIM/BIMI
# are recorded but never flagged absent (selector-guessing / branding — too false-positive-prone).
sp_email_posture(){
  local d="$1" ts="${SCAN_TS:-1970-01-01T00:00:00Z}" txt='{}' caa='{}' caa_assessed=false
  [[ -s "$d/in_domains.txt" ]] || return 0
  # only assess when the TXT collection actually ran (email_txt.json exists). A MISSING artifact means
  # "not assessed" (DNS/resolver/dnsx failure), NOT "all records missing" — this prevents false findings.
  [[ -f "$d/email_txt.json" ]] || return 0
  # a present-but-MALFORMED artifact is also "not assessed", not "empty DNS" — a jq parse failure skips
  # it rather than defaulting to {} (which would emit false missing-record findings).
  txt="$(jq -cs 'map({(.host): (.txt // [])}) | add // {}' "$d/email_txt.json" 2>/dev/null)" || return 0
  if [[ -f "$d/email_caa.json" ]]; then
    caa="$(jq -cs 'map({(.host): (.caa // [])}) | add // {}' "$d/email_caa.json" 2>/dev/null)" && caa_assessed=true || caa='{}'
  fi
  jq -R -c --argjson txt "$txt" --argjson caa "$caa" --argjson caa_assessed "$caa_assessed" --arg ts "$ts" '
    . as $D | select($D != "")
    | ($txt[$D] // [])                                          as $apex
    | ($txt["_dmarc."+$D] // [])                                as $dmarc
    | ($txt["_mta-sts."+$D] // [])                              as $mtasts
    | ($caa[$D] // [])                                          as $caarec
    | (any($apex[];  ascii_downcase|startswith("v=spf1")))      as $spf
    | (any($dmarc[]; ascii_downcase|contains("v=dmarc1")))      as $has_dmarc
    | ($dmarc | map(select(ascii_downcase|contains("v=dmarc1")))[0] // "") as $drec
    | (($drec | ascii_downcase | capture("p=\\s*(?<p>none|quarantine|reject)").p)? // null) as $pol
    | (any($mtasts[]; ascii_downcase|contains("v=stsv1")))      as $mtasts_ok
    | (($caarec|length)>0)                                      as $caa_ok
    | [ (if $spf|not then {sev:"medium",id:"email-spf-missing",title:"SPF record not published",
           desc:"No v=spf1 TXT record at the domain apex; the domain is easier to spoof."} else empty end),
        (if $has_dmarc|not then {sev:"medium",id:"email-dmarc-missing",title:"DMARC record not published",
           desc:"No v=DMARC1 record at _dmarc; recipients have no policy for spoofed mail."}
         elif $pol=="none" then {sev:"low",id:"email-dmarc-p-none",title:"DMARC policy is p=none (monitoring only)",
           desc:"DMARC is published but not enforced (p=none)."} else empty end),
        (if $mtasts_ok|not then {sev:"low",id:"email-mta-sts-missing",title:"MTA-STS not published",
           desc:"No _mta-sts TXT record; SMTP TLS is not enforced via MTA-STS."} else empty end),
        (if ($caa_assessed and ($caa_ok|not)) then {sev:"info",id:"email-caa-missing",title:"No CAA record",
           desc:"No CAA record; any CA may issue certificates for this domain."} else empty end) ][]
    | { source_module:"STRIP", source_tool:"dnsx", scan_id:$ts, observed_at:$ts,
        ip_at_observation_time:null, hostname_at_observation_time:$D, hostname_resolvable:null,
        url:null, port:null, category:"email_security", template_id:.id, cve_id:null, cwe_id:null,
        title:.title, description:.desc, severity:.sev, cvss_score:null, cvss_vector:null,
        matched_at:null, evidence:null, references:[], remediation:null, raw:null }
  ' "$d/in_domains.txt"
}
# subdomain-takeover findings: candidates are CNAME'd hosts (resolved.json). CONFIRMED = the nuclei
# takeover pass matched the host (fingerprint body); POTENTIAL = the CNAME points to a takeover-prone
# service but nuclei did not confirm; SAFE is not emitted. Detection-only — STRIP never claims the
# resource. Pure host-jq, unit-tested in tests/parsers.
sp_takeover_findings(){
  local d="$1" ts="${SCAN_TS:-1970-01-01T00:00:00Z}" confirmed='[]'
  [[ -s "$d/resolved.json" ]] || return 0
  # normalize confirmed hosts to a bare hostname — nuclei may emit URL-shaped .host / matched-at / url,
  # which would otherwise never match resolved.json's bare hostname (downgrading confirmed → potential)
  [[ -s "$d/takeover.jsonl" ]] && confirmed="$(jq -cs '[ .[] | (.host // .["matched-at"] // .url // "") | tostring
      | sub("^[a-z]+://";"") | sub("[:/].*$";"") ] | map(select(.!="")) | unique' "$d/takeover.jsonl" 2>/dev/null)" || true
  [[ "$confirmed" == \[* ]] || confirmed='[]'   # malformed takeover.jsonl → jq failed → keep a valid empty array (potentials still emit)
  local svc='(github\.io|s3[.-]|amazonaws\.com|herokuapp\.com|herokudns\.com|netlify\.(app|com)|cloudfront\.net|azurewebsites\.net|cloudapp\.net|trafficmanager\.net|blob\.core\.windows\.net|fastly\.net|ghost\.io|pantheonsite\.io|readthedocs\.io|surge\.sh|bitbucket\.io|wpengine\.com|helpscoutdocs\.com)'
  jq -c --argjson confirmed "$confirmed" --arg ts "$ts" --arg svc "$svc" '
    ( .cname // null ) as $c
    | ( if ($c|type)=="array" then ($c[0] // null) elif (($c|type)=="string" and $c!="") then $c else null end ) as $cn
    | select($cn != null)                                        # only CNAME'"'"'d hosts are candidates
    | .host as $h
    | (($confirmed | index($h)) != null)   as $isconf
    | (($cn|ascii_downcase) | test($svc))  as $svchit
    | (if $isconf then "confirmed" elif $svchit then "potential" else "safe" end) as $state
    | select($state != "safe")
    | { source_module:"STRIP", source_tool:"nuclei", scan_id:$ts, observed_at:$ts,
        ip_at_observation_time:null, hostname_at_observation_time:$h, hostname_resolvable:null,
        url:null, port:null, category:"takeover", state:$state,
        template_id:(if $isconf then "takeover-confirmed" else "takeover-potential" end),
        cve_id:null, cwe_id:null,
        title:("Possible subdomain takeover (" + $state + "): " + $h),
        description:("Dangling CNAME " + $h + " -> " + $cn +
          (if $isconf then ", confirmed claimable by the nuclei takeover pass."
           else ", points to a takeover-prone service; verify manually." end)),
        severity:(if $isconf then "high" else "medium" end),
        cvss_score:null, cvss_vector:null, matched_at:null,
        evidence:$cn, references:[], remediation:"Remove the dangling DNS record or re-claim the third-party resource.", raw:null }
  ' "$d/resolved.json"
}
# seed-expansion scope-control guardrail: given the exclusion count and the acknowledge flag, decide
# whether expansion may proceed. Refuses when there are ZERO exclusions unless expansion of the whole
# ASN was explicitly acknowledged. Unit-tested in tests/parsers.
sp_seed_guard(){  # $1 = exclusion count, $2 = acknowledge_full_asn -> prints "expand" | "refuse"
  local n="${1:-0}" ack="${2:-false}"
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  if [[ "$n" -eq 0 && "$ack" != "true" ]]; then echo "refuse"; else echo "expand"; fi
}
# filter a CIDR list (stdin) against an exclusion file ($1, one entry per line) by CONTAINMENT/overlap —
# a child CIDR (10.1.2.0/24) is dropped when a broader exclusion (10.0.0.0/8) is set, and vice-versa.
# Uses python3 ipaddress; falls back to exact-line match (with a warning) only if python3 is absent.
# Empty/absent exclusion file → pass through. stdin→stdout. Unit-tested in tests/parsers.
sp_filter_cidrs(){
  local excl="${1:-}"
  [[ -n "$excl" && -s "$excl" ]] || { cat; return 0; }
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'sp_filter_cidrs: python3 not found — CIDR exclusion is EXACT-MATCH only; install python3 for containment\n' >&2
    grep -vxF -f "$excl" || true; return 0
  fi
  local tmp; tmp="$(mktemp)"; cat > "$tmp"   # capture stdin CIDRs to a file (heredoc below is python's script)
  python3 - "$excl" "$tmp" <<'PY'
import sys, ipaddress
ex=[]
for line in open(sys.argv[1]):
    t=line.split('#',1)[0].strip()
    if not t: continue
    try: ex.append(ipaddress.ip_network(t, strict=False))
    except ValueError: pass
for line in open(sys.argv[2]):
    c=line.strip()
    if not c: continue
    try: net=ipaddress.ip_network(c, strict=False)
    except ValueError:
        print(c); continue           # pass through anything unparseable
    if any(net.version==e.version and net.overlaps(e) for e in ex):
        continue                      # overlaps an exclusion → drop (conservative: never scan excluded)
    print(c)
PY
  rm -f "$tmp"
}

setup() {
  echo "═══════════════════════════════════════════════"
  echo "  STRIP Initial Setup"
  echo "═══════════════════════════════════════════════"
  echo ""
  
  # Create Docker volume for templates
  log "Creating Docker volume for Nuclei templates..."
  docker volume create nuclei-templates 2>/dev/null || true
  
  # Create local directories for output
  log "Creating output directories..."
  mkdir -p "$DATA_DIR/out"
  
  # Download Nuclei templates to Docker volume
  log "Downloading Nuclei vulnerability templates..."
  log "This may take 2-5 minutes on first run..."
  echo ""
  
  docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    projectdiscovery/nuclei:latest \
    -update-templates
  
  # Verify templates were downloaded
  TEMPLATE_COUNT=$(docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    alpine:latest \
    find /root/nuclei-templates -name "*.yaml" 2>/dev/null | wc -l | tr -d ' ')
  
  if [ "$TEMPLATE_COUNT" -gt 1000 ]; then
    echo ""
    log "✓ Setup complete!"
    log "Templates installed: $TEMPLATE_COUNT templates"
    log "Storage: Docker volume 'nuclei-templates' (isolated from host)"
    echo ""
    echo "Next steps:"
    echo "  ./stripctl discover     # Discover targets"
    echo "  ./stripctl run daily    # Run daily scan"
    echo ""
  else
    echo ""
    echo "[ERR] Setup failed - only $TEMPLATE_COUNT templates found"
    echo "Expected 10,000+ templates"
    exit 1
  fi
}

ensure_nuclei_templates() {
  # Check if Docker volume exists
  if ! docker volume inspect nuclei-templates >/dev/null 2>&1; then
    log "⚠ Nuclei templates volume not found"
    log "Running first-time setup..."
    echo ""
    setup
    return
  fi
  
  # Check if volume has templates
  TEMPLATE_COUNT=$(docker run --rm \
    -v nuclei-templates:/root/nuclei-templates \
    alpine:latest \
    find /root/nuclei-templates -name "*.yaml" 2>/dev/null | wc -l | tr -d ' ')
  
  if [ "$TEMPLATE_COUNT" -lt 1000 ]; then
    log "⚠ Nuclei templates incomplete ($TEMPLATE_COUNT templates)"
    log "Running setup to download templates..."
    echo ""
    setup
  else
    log "✓ Nuclei templates found ($TEMPLATE_COUNT templates)"
  fi
}

discover(){
  local domains="$STRIP_HOME/$(yqg '.inputs.domains_file' | sed 's#^\./##')"
  local resolv="$STRIP_HOME/$(yqg '.inputs.resolvers_file' | sed 's#^\./##')"
  need "$domains"
  log "Output → $OUT"
  cp "$domains" "$OUT/domains.txt"

  # ── Classify inputs: domain | IP | CIDR ───────────────────────────────────
  : > "$OUT/in_domains.txt"; : > "$OUT/in_ips.txt"; : > "$OUT/in_cidrs.txt"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -z "$line" ]] && continue
    if   [[ "$line" == */* ]]; then printf '%s\n' "$line" >> "$OUT/in_cidrs.txt"     # IPv4/IPv6 CIDR
    elif [[ "$line" == *:* ]]; then printf '%s\n' "$line" >> "$OUT/in_ips.txt"       # IPv6 literal
    elif [[ "$line" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then printf '%s\n' "$line" >> "$OUT/in_ips.txt"  # IPv4
    else printf '%s\n' "$line" >> "$OUT/in_domains.txt"                              # domain
    fi
  done < "$OUT/domains.txt"
  log "inputs → domains:$(wc -l <"$OUT/in_domains.txt"|tr -d ' ') ips:$(wc -l <"$OUT/in_ips.txt"|tr -d ' ') cidrs:$(wc -l <"$OUT/in_cidrs.txt"|tr -d ' ')"
  seed_expand   # opt-in: asnmap ASN→CIDR expansion into in_cidrs.txt (gated by the scope-control guardrail)

  # ── Subdomain discovery + DNS resolution (domains only) ───────────────────
  : > "$OUT/hosts_resolved.txt"
  if [[ -s "$OUT/in_domains.txt" ]]; then
    log "subfinder…"
    crun subfinder -dL "/data/out/$TS/in_domains.txt" -all -silent -o "/data/out/$TS/subs.subfinder.txt" || true
    if [[ "${1:-}" == "sweep" ]]; then
      log "amass (passive, sweep)…"
      crun amass enum -norecursive -passive -df "/data/out/$TS/in_domains.txt" -o "/data/out/$TS/subs.amass.txt" || true
    fi
    # include apex domains + all sub sources (subs.*.txt = subfinder [+ amass]) so nothing is dropped.
    # subs.*.txt may be absent if a source found nothing — tolerate the empty glob so set -e can't abort
    # here; the apex domains file always exists and is the guaranteed fallback.
    : > "$OUT/subs.txt"
    cat "$OUT"/subs.*.txt 2>/dev/null >> "$OUT/subs.txt" || true
    cat "$OUT/in_domains.txt" >> "$OUT/subs.txt"
    sort -u -o "$OUT/subs.txt" "$OUT/subs.txt"

    # optional custom resolvers: build one clean file (strip CR, inline comments, whitespace, blanks)
    # and pass it as -r <file> — dnsx takes a resolver file, which is unambiguous vs. many -r flags
    local nresolv=0 resflag=()
    if [[ -f "$resolv" ]]; then
      sp_clean_resolvers < "$resolv" > "$OUT/resolvers.clean.txt" 2>/dev/null || true
      nresolv="$(grep -c . "$OUT/resolvers.clean.txt" 2>/dev/null)"; nresolv="${nresolv:-0}"
      [[ "$nresolv" -gt 0 ]] && resflag=(-r "/data/out/$TS/resolvers.clean.txt")
    fi
    if [[ "$nresolv" -gt 0 ]]; then
      log "dnsx ($nresolv custom resolvers) — resolving $(wc -l <"$OUT/subs.txt"|tr -d ' ') names…"
    else
      log "dnsx — resolving $(wc -l <"$OUT/subs.txt"|tr -d ' ') names…"
    fi
    # discard the stdout result echo (results go to the -o JSON) but KEEP stderr in dnsx.err for diagnosis
    crun dnsx -l "/data/out/$TS/subs.txt" ${resflag[@]+"${resflag[@]}"} -a -aaaa -cname -json -silent -o "/data/out/$TS/resolved.json" >/dev/null 2>"$OUT/dnsx.err" \
      || log "dnsx exited $? — see $OUT/dnsx.err"
    # resolvable hostnames (source for hostname_resolvable + naabu targets), derived from the JSON
    if [[ -s "$OUT/resolved.json" ]]; then
      jq -r 'select(((.a//[])+(.aaaa//[]))|length>0) | .host' "$OUT/resolved.json" 2>/dev/null | sort -u > "$OUT/resolved.txt"
      cp "$OUT/resolved.txt" "$OUT/hosts_resolved.txt" 2>/dev/null || true
    fi
  else
    log "no domains in input — skipping subfinder + dnsx"
  fi

  # ── Combined scan targets: resolved hosts + literal IPs + CIDRs ────────────
  cat "$OUT/hosts_resolved.txt" "$OUT/in_ips.txt" "$OUT/in_cidrs.txt" 2>/dev/null | sort -u > "$OUT/scan_targets.txt"
  if [[ ! -s "$OUT/scan_targets.txt" ]]; then
    log "no scan targets — nothing to scan"; return 0
  fi

  log "naabu ports (top)…"
  crun naabu -list "/data/out/$TS/scan_targets.txt" -top-ports "$(yqg '.scan.naabu.top_ports')" --rate "$(yqg '.scan.naabu.rate')" -silent -o "/data/out/$TS/ports.naabu.txt" || true

  log "nmap follow-up (light -sV, discovered ports)…"
  # host:port → hosts + the union of open ports (last-colon split, IPv6-safe — see sp_split_hostports)
  sp_split_hostports < "$OUT/ports.naabu.txt" > "$OUT/.hostport.tsv" 2>/dev/null || true
  cut -f1 "$OUT/.hostport.tsv" | sort -u > "$OUT/hosts_for_nmap.txt"
  local nmap_ports; nmap_ports="$(cut -f2 "$OUT/.hostport.tsv" | sort -un | paste -sd, -)"
  # nmap can't mix address families in one run. IP literals go to their own family; HOSTNAMES go to
  # BOTH runs so dual-stack is fingerprinted (v4 resolves the A, -6 resolves the AAAA); nmap keeps the
  # hostname in its XML, so merge re-associates it. -Pn: naabu already proved the ports open, so skip
  # host discovery (ICMP/PN probes are often firewalled and would make nmap wrongly skip live hosts).
  sp_nmap_hosts 4 < "$OUT/hosts_for_nmap.txt" > "$OUT/hosts_nmap4.txt" || true
  sp_nmap_hosts 6 < "$OUT/hosts_for_nmap.txt" > "$OUT/hosts_nmap6.txt" || true
  if [[ -s "$OUT/hosts_nmap4.txt" && -n "$nmap_ports" ]]; then
    crun nmap -Pn -sV --version-light -T3 -iL "/data/out/$TS/hosts_nmap4.txt" -p "$nmap_ports" -oX "/data/out/$TS/nmap.xml" || true
  fi
  if [[ -s "$OUT/hosts_nmap6.txt" && -n "$nmap_ports" ]]; then
    crun nmap -6 -Pn -sV --version-light -T3 -iL "/data/out/$TS/hosts_nmap6.txt" -p "$nmap_ports" -oX "/data/out/$TS/nmap6.xml" || true
  fi

  log "httpx (title/tech)…"
  # build URLs preserving the discovered port; last-colon split + IPv6 bracketing (see sp_urls_from_hostports)
  sp_urls_from_hostports < "$OUT/ports.naabu.txt" 2>/dev/null | sort -u > "$OUT/urls.txt" || true
  [[ -s "$OUT/urls.txt" ]] && crun httpx \
    -l "/data/out/$TS/urls.txt" \
    -rl "$(yqg '.scan.httpx.rate_limit')" \
    -json -silent -status-code -title -tech-detect \
    -server -content-type -content-length -location -hash sha256 -tls-grab -favicon \
    -o "/data/out/$TS/httpx.json" || true

  # ── Crawl (sweep only): expand the URL surface so nuclei tests more than site roots ──
  if [[ "${1:-}" == "sweep" && "$(yqg '.scan.katana.enable')" == "true" && -s "$OUT/httpx.json" ]]; then
    local jc=""
    [[ "$(yqg '.scan.katana.js_crawl')" == "true" ]] && jc="-jc" || true
    jq -r '.url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/httpx_live.txt"
    log "katana (crawl, depth $(yqg '.scan.katana.depth'))…"
    crun katana -list "/data/out/$TS/httpx_live.txt" -d "$(yqg '.scan.katana.depth')" $jc -silent -o "/data/out/$TS/katana.txt" || true
    if [[ -s "$OUT/katana.txt" ]]; then
      cat "$OUT/urls.txt" "$OUT/katana.txt" 2>/dev/null | sort -u > "$OUT/urls.all.txt" && mv "$OUT/urls.all.txt" "$OUT/urls.txt"
      log "katana: url surface expanded to $(wc -l <"$OUT/urls.txt"|tr -d ' ')"
    fi
  fi

  log "[✓] STRIP discovery complete."
}

webscan(){
  local sev="${1:-$(yqg '.scan.nuclei.severity_daily')}"
  # nuclei scans ONLY httpx-validated live services (+ katana crawl in a sweep) — never the raw naabu
  # http×https×port cross-product in urls.txt (unvalidated; CDN/dead-scheme noise). httpx emits no JSON
  # for failed probes, so "no validated targets" (all probes failed, or no web ports at all) means we
  # SKIP nuclei rather than scan unvalidated URLs.
  sp_nuclei_target_list "$OUT" > "$OUT/nuclei_targets.txt" 2>/dev/null || true
  if [[ -s "$OUT/nuclei_targets.txt" ]]; then
    local nlive; nlive="$(wc -l <"$OUT/nuclei_targets.txt" | tr -d ' ')"
    log "nuclei HTTP (severity: $sev) — $nlive validated target(s)…"
    crun nuclei -stats -rl "$(yqg '.scan.nuclei.rate_limit')" -c "$(yqg '.scan.nuclei.concurrency')" \
      -severity "$sev" -ni -jsonl -l "/data/out/$TS/nuclei_targets.txt" -o "/data/out/$TS/nuclei.jsonl" || true
  else
    log "nuclei: no validated web targets — skipping"
  fi

  if [[ "$(yqg '.scan.tls.sslyze')" == "true" ]]; then
    # sslyze --targets_in wants host:port (not URLs) — derive from the discovered https services
    : > "$OUT/sslyze_targets.txt"
    [[ -s "$OUT/httpx.json" ]] && jq -r 'select(.scheme=="https") | .url' "$OUT/httpx.json" 2>/dev/null \
      | sed -E 's#^https?://##; s#/.*$##' | sort -u > "$OUT/sslyze_targets.txt" || true
    if [[ -s "$OUT/sslyze_targets.txt" ]]; then
      log "sslyze ($(wc -l <"$OUT/sslyze_targets.txt"|tr -d ' ') targets)…"
      crun sslyze --json_out "/data/out/$TS/sslyze.json" --targets_in "/data/out/$TS/sslyze_targets.txt" || true
    else
      log "sslyze: no https targets — skipping"
    fi
  fi
  log "[✓] Web/TLS done."
}

tls(){
  [[ "$(yqg '.scan.tls.testssl')" == "true" ]] || { log "testssl disabled"; return 0; }
  # Assess live HTTPS services only (skip plain http); derived from httpx output
  if [[ -s "$OUT/httpx.json" ]]; then
    jq -r 'select(.scheme=="https") | .url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/https_urls.txt" || true
  fi
  if [[ ! -s "$OUT/https_urls.txt" ]]; then
    log "testssl: no HTTPS services found — skipping"
    return 0
  fi
  local n; n="$(wc -l < "$OUT/https_urls.txt" | tr -d ' ')"
  log "testssl (TLS assessment, --fast) on $n target(s)…"
  crun testssl --fast --warnings batch \
    --file "/data/out/$TS/https_urls.txt" \
    --jsonfile "/data/out/$TS/testssl.json" || true
  log "[✓] testssl done."
}

shots(){
  [[ "$(yqg '.screenshots.enable')" == "true" ]] || { log "screenshots disabled"; return 0; }
  [[ -s "$OUT/httpx.json" ]] || { log "shots: no live web services — skipping"; return 0; }
  jq -r '.url' "$OUT/httpx.json" 2>/dev/null | sort -u > "$OUT/shot_urls.txt"
  [[ -s "$OUT/shot_urls.txt" ]] || { log "shots: no urls — skipping"; return 0; }
  mkdir -p "$OUT/screenshots"
  log "gowitness (screenshots)…"
  crun gowitness scan file \
    -f "/data/out/$TS/shot_urls.txt" \
    --screenshot-path "/data/out/$TS/screenshots" \
    --write-jsonl --write-jsonl-file "/data/out/$TS/gowitness.jsonl" \
    --threads "$(yqg '.screenshots.gowitness.workers')" \
    --delay "$(yqg '.screenshots.gowitness.delay')" || true
  log "[✓] screenshots done."
}

email(){
  [[ "$(yqg '.scan.email.enable')" == "true" ]] || { log "email posture disabled"; return 0; }
  [[ -s "$OUT/in_domains.txt" ]] || { log "email posture: no domains — skipping"; return 0; }
  log "email posture (SPF/DMARC/DKIM/BIMI/MTA-STS/CAA)…"
  local sels; sels="$(yqg '.scan.email.dkim_selectors | join(" ")' 2>/dev/null)"
  [[ -z "$sels" || "$sels" == "null" ]] && sels="default google selector1 selector2 k1"
  # build the TXT query set: apex (SPF), _dmarc, _mta-sts, default._bimi, <selector>._domainkey per domain
  : > "$OUT/.email_names.txt"
  local dom s
  while IFS= read -r dom; do
    dom="${dom%$'\r'}"; [[ -n "$dom" ]] || continue
    printf '%s\n_dmarc.%s\n_mta-sts.%s\ndefault._bimi.%s\n' "$dom" "$dom" "$dom" "$dom" >> "$OUT/.email_names.txt"
    for s in $sels; do printf '%s._domainkey.%s\n' "$s" "$dom" >> "$OUT/.email_names.txt"; done
  done < "$OUT/in_domains.txt"
  # DNSSEC and DANE/TLSA are intentionally NOT assessed here — dnsx cannot query them (needs dig/other).
  # materialize the artifact ONLY on success (even with 0 records) so posture assessment can tell
  # "assessed, nothing found" from "collection failed" (removed → sp_email_posture skips → no false findings)
  if crun dnsx -l "/data/out/$TS/.email_names.txt" -txt -json -silent -o "/data/out/$TS/email_txt.json" >/dev/null 2>"$OUT/email.err"; then
    [[ -f "$OUT/email_txt.json" ]] || : > "$OUT/email_txt.json"
  else
    log "email dnsx(txt) exit $? — see email.err (email posture NOT assessed)"; rm -f "$OUT/email_txt.json"
  fi
  if crun dnsx -l "/data/out/$TS/in_domains.txt" -caa -json -silent -o "/data/out/$TS/email_caa.json" >/dev/null 2>>"$OUT/email.err"; then
    [[ -f "$OUT/email_caa.json" ]] || : > "$OUT/email_caa.json"
  else
    log "email dnsx(caa) exit $? — see email.err (CAA not assessed)"; rm -f "$OUT/email_caa.json"
  fi
  log "[✓] email posture done."
}

takeover(){
  [[ "$(yqg '.scan.takeover.enable')" == "true" ]] || { log "takeover detection disabled"; return 0; }
  [[ -s "$OUT/resolved.json" ]] || { log "takeover: no resolved hosts — skipping"; return 0; }
  # candidates = CNAME'd hosts; a dangling CNAME is the takeover vector. Accept string OR array cname
  # (same normalization sp_takeover_findings uses) so every candidate also gets the nuclei confirm pass.
  jq -r '( if (.cname|type)=="array" then (.cname[0] // null)
           elif ((.cname|type)=="string" and .cname!="") then .cname else null end ) as $cn
         | select($cn != null) | .host' "$OUT/resolved.json" 2>/dev/null | sort -u > "$OUT/.takeover_candidates.txt" || true
  [[ -s "$OUT/.takeover_candidates.txt" ]] || { log "takeover: no CNAME candidates — skipping"; return 0; }
  sed 's#^#https://#' "$OUT/.takeover_candidates.txt"  > "$OUT/.takeover_urls.txt"
  sed 's#^#http://#'  "$OUT/.takeover_candidates.txt" >> "$OUT/.takeover_urls.txt"
  local n; n="$(grep -c . "$OUT/.takeover_candidates.txt")"
  log "subdomain takeover (nuclei -tags takeover) on $n CNAME candidate(s)…"
  crun nuclei -tags takeover -l "/data/out/$TS/.takeover_urls.txt" -jsonl -silent -o "/data/out/$TS/takeover.jsonl" >/dev/null 2>"$OUT/takeover.err" \
    || log "takeover nuclei exit $? — see takeover.err"
  log "[✓] takeover detection done."
}

# seed expansion (opt-in): asnmap turns the input domains into their ASN's CIDRs and adds them to the
# scan scope. This CHANGES WHAT IS SCANNED, so it is gated behind a scope-control guardrail (refuses to
# expand without an exclusion list unless the full ASN is explicitly acknowledged). Needs a PDCP_API_KEY.
seed_expand(){
  [[ "$(yqg '.seed_expansion.enable')" == "true" ]] || return 0
  [[ -s "$OUT/in_domains.txt" ]] || { log "seed expansion: no domains — skipping"; return 0; }
  local nexcl ack
  nexcl="$(yqg '.seed_expansion.exclusions | length' 2>/dev/null)"; [[ "$nexcl" =~ ^[0-9]+$ ]] || nexcl=0
  ack="$(yqg '.seed_expansion.acknowledge_full_asn' 2>/dev/null)"
  if [[ "$(sp_seed_guard "$nexcl" "$ack")" == "refuse" ]]; then
    log "⚠ seed expansion enabled but NO exclusions set — refusing to expand scope."
    log "   set seed_expansion.exclusions, or acknowledge_full_asn: true to scan the entire ASN."
    return 0
  fi
  : > "$OUT/.seed_excl.txt"
  [[ "$nexcl" -gt 0 ]] && yqg '.seed_expansion.exclusions[]' 2>/dev/null | grep -v '^null$' > "$OUT/.seed_excl.txt" || true
  # exclusions are enforced by CIDR containment (python3); refuse rather than under-enforce the guardrail
  if [[ -s "$OUT/.seed_excl.txt" ]] && ! command -v python3 >/dev/null 2>&1; then
    log "⚠ seed expansion: python3 is required to enforce CIDR exclusions by containment — refusing to expand."
    return 0
  fi
  local domlist; domlist="$(paste -sd, "$OUT/in_domains.txt" 2>/dev/null)"
  log "seed expansion (asnmap → ASN CIDRs)…"
  crun asnmap -d "$domlist" -silent -o "/data/out/$TS/asnmap.cidrs.txt" >/dev/null 2>"$OUT/asnmap.err" \
    || log "asnmap exit $? — see asnmap.err (a PDCP_API_KEY is required)"
  [[ -s "$OUT/asnmap.cidrs.txt" ]] || { log "seed expansion: asnmap returned no CIDRs (missing PDCP_API_KEY?)"; return 0; }
  # apply exclusions BEFORE anything is scanned; the filtered set is the provenance record for the manifest
  sort -u "$OUT/asnmap.cidrs.txt" | sp_filter_cidrs "$OUT/.seed_excl.txt" | sort -u > "$OUT/seed_expansion.cidrs.txt" || true
  local nadd; nadd="$(grep -c . "$OUT/seed_expansion.cidrs.txt" 2>/dev/null || echo 0)"
  cat "$OUT/seed_expansion.cidrs.txt" >> "$OUT/in_cidrs.txt"
  sort -u -o "$OUT/in_cidrs.txt" "$OUT/in_cidrs.txt"
  log "seed expansion: +$nadd CIDR(s) into scan scope ($nexcl exclusion rule(s) applied)"
}

# run_manifest.json (sensor-output/1.0 §5) — provenance + legal/authorization record
manifest(){
  local R="$1" nowu dur authed streams counts nd ni nc s n
  nowu="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  dur=$(( $(date +%s) - ${START_EPOCH:-$(date +%s)} ))
  authed="$(yqg '.run.authorized_by' 2>/dev/null)"; [[ -z "$authed" || "$authed" == "null" ]] && authed="UNATTESTED"
  # count input classes defensively: a standalone `merge` on a run dir may have no in_*.txt files.
  # NOTE: `x=$(wc -l < missing)` makes the ASSIGNMENT itself exit non-zero → set -e would abort here,
  # so guard on file existence and only count files that are actually present.
  nd=0; ni=0; nc=0
  [[ -s "$R/in_domains.txt" ]] && nd=$(grep -c '' "$R/in_domains.txt" 2>/dev/null); nd=${nd:-0}
  [[ -s "$R/in_ips.txt"     ]] && ni=$(grep -c '' "$R/in_ips.txt"     2>/dev/null); ni=${ni:-0}
  [[ -s "$R/in_cidrs.txt"   ]] && nc=$(grep -c '' "$R/in_cidrs.txt"   2>/dev/null); nc=${nc:-0}
  streams='[]'; counts='{}'
  for s in hosts services web_assets tls dns findings; do
    [[ -s "$R/$s.ndjson" ]] || continue
    streams=$(jq -c --arg s "$s.ndjson" '. + [$s]' <<<"$streams")
    if grep -q '"message":"No records' "$R/$s.ndjson"; then n=0; else n=$(grep -c '' "$R/$s.ndjson" 2>/dev/null || echo 0); fi
    counts=$(jq -c --arg k "$s" --argjson v "${n:-0}" '. + {($k):$v}' <<<"$counts")
  done
  # seed-expansion provenance (asnmap): which CIDRs were added to scope and which exclusions applied
  local seedj='null' seedci='[]' seedex='[]'
  if [[ -s "$R/seed_expansion.cidrs.txt" ]]; then
    seedci="$(jq -R . "$R/seed_expansion.cidrs.txt" | jq -cs 'map(select(.!=""))')"
    [[ -s "$R/.seed_excl.txt" ]] && seedex="$(jq -R . "$R/.seed_excl.txt" | jq -cs 'map(select(.!=""))')"
    seedj="$(jq -cn --argjson c "$seedci" --argjson e "$seedex" '{source:"asnmap", cidrs_added:$c, exclusions_applied:$e}')"
  fi
  jq -n \
    --arg m STRIP --arg sid "$SCAN_TS" --arg prof "${PROFILE:-manual}" \
    --arg st "$SCAN_TS" --arg fin "$nowu" --argjson dur "$dur" \
    --arg op "$(id -un 2>/dev/null || echo user)@$(hostname -s 2>/dev/null || echo host)" \
    --arg auth "$authed" \
    --argjson tot "$((nd+ni+nc))" --argjson ips "$ni" --argjson cidrs "$nc" --argjson hn "$nd" \
    --argjson streams "$streams" --argjson counts "$counts" --argjson seedexp "$seedj" \
    '{source_module:$m, scan_id:$sid, spec_version:"sensor-output/1.0", profile:$prof,
      started_at:$st, finished_at:$fin, duration_seconds:$dur, operator:$op, authorized_by:$auth,
      targets:{total:$tot, ips:$ips, cidrs:$cidrs, hostnames:$hn},
      tool_versions:{}, streams_emitted:$streams, record_counts:$counts, seed_expansion:$seedexp}' \
    > "$R/run_manifest.json" 2>/dev/null || true
}

merge(){
  local R="$OUT"
  log "Normalizing raw tool outputs into sensor-output/1.0 streams (hosts/services/web_assets/tls/dns/findings)…"

  # per-stream sentinel (spec §2.11): distinguish "no records" from a failed run
  _sent(){ [[ -s "$1" ]] || printf '{"source_module":"STRIP","scan_id":"%s","observed_at":"%s","message":"No records for this stream"}\n' "$SCAN_TS" "$SCAN_TS" > "$1"; }

  # ── lookups ───────────────────────────────────────────────────────────────
  if [[ -s "$R/gowitness.jsonl" ]]; then
    jq -s 'map(select(.url) | {(.url): ("screenshots/" + (.file_name // .screenshot // ""))}) | add // {}' \
      "$R/gowitness.jsonl" > "$R/.shots_map.json" 2>/dev/null || echo '{}' > "$R/.shots_map.json"
  else echo '{}' > "$R/.shots_map.json"; fi
  local SHOTS RES_MAP='{}' H2IP='{}'
  SHOTS="$(cat "$R/.shots_map.json")"
  [[ -s "$R/resolved.txt" ]]  && { RES_MAP="$(sort -u "$R/resolved.txt" | jq -R . | jq -cs 'map({(.):true})|add // {}')" || RES_MAP='{}'; }
  [[ -s "$R/resolved.json" ]] && { H2IP="$(jq -cs 'map({(.host): (((.a//[])[0]) // ((.aaaa//[])[0]))}) | add // {}' "$R/resolved.json")" || H2IP='{}'; }

  # ── dns.ndjson (dnsx) ──────────────────────────────────────────────────────
  [[ -s "$R/resolved.json" ]] && \
  jq -c --argjson resolved "$RES_MAP" '
    ( [ (.a//[])[]    | {t:"A",   v:.} ]
    + [ (.aaaa//[])[] | {t:"AAAA",v:.} ]
    + ( if (.cname|type)=="string" and .cname!="" then [{t:"CNAME",v:.cname}]
        elif (.cname|type)=="array" then (.cname|map({t:"CNAME",v:.})) else [] end ) ) as $recs
    | .host as $name | (.ttl // null) as $ttl
    | $recs[]
    | { source_module:"STRIP", source_tool:"dnsx", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
        ip_at_observation_time: null,
        hostname_at_observation_time: $name,
        hostname_resolvable: (if $name==null then null else ($resolved[$name] // true) end),
        record_type: .t, name: $name, value: .v, ttl: $ttl, root_domain: null, is_wildcard: null }
  ' "$R/resolved.json" > "$R/dns.ndjson" 2>/dev/null || true
  # email-posture records (TXT/CAA) → dns facts, appended before the sentinel check
  [[ -s "$R/email_txt.json" ]] && jq -c --arg ts "$SCAN_TS" '
    .host as $n | (.txt // [])[] |
    { source_module:"STRIP", source_tool:"dnsx", scan_id:$ts, observed_at:$ts,
      ip_at_observation_time:null, hostname_at_observation_time:$n, hostname_resolvable:null,
      record_type:"TXT", name:$n, value:., ttl:null, root_domain:null, is_wildcard:null }
  ' "$R/email_txt.json" >> "$R/dns.ndjson" 2>/dev/null || true
  [[ -s "$R/email_caa.json" ]] && jq -c --arg ts "$SCAN_TS" '
    .host as $n | (.caa // [])[] |
    { source_module:"STRIP", source_tool:"dnsx", scan_id:$ts, observed_at:$ts,
      ip_at_observation_time:null, hostname_at_observation_time:$n, hostname_resolvable:null,
      record_type:"CAA", name:$n, value:., ttl:null, root_domain:null, is_wildcard:null }
  ' "$R/email_caa.json" >> "$R/dns.ndjson" 2>/dev/null || true
  _sent "$R/dns.ndjson"

  # ── hosts.ndjson (one record per observed IP) ─────────────────────────────
  # NOTE the trailing `|| true`: when in_ips.txt is absent/empty (any domains-only run) the group's
  # last command returns non-zero, and under `set -o pipefail` that would abort the whole merge —
  # leaving ONLY dns.ndjson. Do not remove it.
  { [[ -s "$R/resolved.json" ]] && jq -r '((.a//[])[]),((.aaaa//[])[])' "$R/resolved.json";
    [[ -s "$R/in_ips.txt" ]] && cat "$R/in_ips.txt"; } 2>/dev/null | sort -u > "$R/.host_ips.txt" || true
  [[ -s "$R/.host_ips.txt" ]] && \
  jq -R -c '
    . as $ip
    | ($ip|test("^(10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|::1$|fc|fd)")) as $priv
    | { source_module:"STRIP", source_tool:"dnsx", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
        ip_at_observation_time:$ip, hostname_at_observation_time:null, hostname_resolvable:null,
        is_private:$priv, ptr_record:null, asn:null, asn_org:null, country_code:null,
        mac:null, netbios:null, os_name:null, os_accuracy:null }
  ' "$R/.host_ips.txt" > "$R/hosts.ndjson" 2>/dev/null || true
  _sent "$R/hosts.ndjson"

  # ── services.ndjson (naabu + nmap → one row per host,port,protocol) ────────
  : > "$R/.services.raw.ndjson"
  if [[ -f "$R/ports.naabu.txt" ]]; then
    # same IPv6-safe splitter discovery uses (strips [] brackets) so naabu rows normalize IDENTICALLY
    # to nmap's — otherwise [2001:db8::1]:443 would keep its brackets and NOT group with nmap's
    # 2001:db8::1, producing two duplicate services for one host:port.
    sp_split_hostports < "$R/ports.naabu.txt" \
      | awk -F'\t' '{ h=$1; gsub(/["\\]/,"",h);
                      printf("{\"tool\":\"naabu\",\"target\":\"%s\",\"port\":%s,\"protocol\":\"tcp\",\"state\":\"open\"}\n", h, $2) }' \
      >> "$R/.services.raw.ndjson" || true
  fi
  for _nx in nmap.xml nmap6.xml; do
    [[ -f "$R/$_nx" ]] || continue
    crun xmlparse python3 -c '
import sys, json, xml.etree.ElementTree as ET
try:
    root = ET.parse(sys.argv[1]).getroot()
except Exception:
    sys.exit(0)
for host in root.findall("host"):
    ip = ""
    for a in host.findall("address"):
        if a.get("addrtype") in ("ipv4", "ipv6"):
            ip = a.get("addr", "")
    hn = None
    for h in host.findall("hostnames/hostname"):
        if h.get("type") == "user":   # the name we targeted, not a reverse-DNS PTR
            hn = h.get("name") or None
            break
    for p in host.findall(".//port"):
        st = p.find("state")
        if st is None or st.get("state") != "open":
            continue
        s = p.find("service")
        g = (lambda k: (s.get(k, "") if s is not None else ""))
        cpes = [c.text for c in (s.findall("cpe") if s is not None else [])]
        print(json.dumps({"tool":"nmap","target":ip,"hostname":hn,"port":int(p.get("portid","0") or 0),
                          "protocol":p.get("protocol","tcp"),"state":st.get("state","open"),
                          "service":g("name"),"product":g("product"),"version":g("version"),
                          "extra_info":g("extrainfo"),"cpe":cpes}))
' "/data/out/$TS/$_nx" 2>/dev/null >> "$R/.services.raw.ndjson" || true
  done
  [[ -s "$R/.services.raw.ndjson" ]] && \
  jq -s -c --argjson resolved "$RES_MAP" --argjson h2ip "$H2IP" '
    def isip($x): ($x|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($x|test(":"));
    def nz: if (.=="" or .==null) then null else . end;
    ( map(fromjson? // .) | map(select(type=="object")) ) as $rows
    | $rows
    | map( .target as $t
      | { ip:(if isip($t) then $t else ($h2ip[$t] // null) end),
          hostname:(if isip($t) then (.hostname // null) else $t end),
          port:.port, protocol:(.protocol//"tcp"), state:(.state//"open"),
          service:(.service|nz), product:(.product|nz), version:(.version|nz),
          extra_info:(.extra_info|nz), cpe:(.cpe//[]), tool:.tool } )
    | group_by([.ip,.port,.protocol])
    | map( (map(select(.tool=="nmap"))|last) as $n
         | (map(.hostname)|map(select(.!=null))|first) as $hn
         | .[0] as $b
         | { source_module:"STRIP", source_tool:(if $n then "nmap" else "naabu" end),
             scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
             ip_at_observation_time:($b.ip|nz),
             hostname_at_observation_time:($hn // null),
             hostname_resolvable:(if ($hn // null)==null then null else ($resolved[$hn] // false) end),
             port:$b.port, protocol:$b.protocol,
             state:( if (map(.state)|any(.=="open")) then "open" else $b.state end ),
             service:($n.service // null), product:($n.product // null), version:($n.version // null),
             extra_info:($n.extra_info // null), banner:null, cpe:($n.cpe // []) } )
    | .[]
  ' "$R/.services.raw.ndjson" > "$R/services.ndjson" 2>/dev/null || true
  _sent "$R/services.ndjson"

  # ── web_assets.ndjson (httpx) ──────────────────────────────────────────────
  [[ -s "$R/httpx.json" ]] && \
  jq -c --argjson shots "$SHOTS" --argjson resolved "$RES_MAP" '
    (.host // "") as $h
    | (($h|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h|test(":"))) as $hisip
    | (if ($h=="" or $hisip) then null else $h end) as $hn
    | { source_module:"STRIP", source_tool:"httpx", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
        ip_at_observation_time: ((.host_ip // ((.a//[])[0]) // "") | if .=="" then null else . end),
        hostname_at_observation_time: $hn,
        hostname_resolvable: (if $hn==null then null else ($resolved[$hn] // false) end),
        url: (.url // ""),
        port: ((.port // "") | if type=="number" then . elif .=="" then null else (tonumber? // null) end),
        status: (.status_code // null),
        title: (.title // null),
        server: (.webserver // null),
        content_type: (.content_type // null),
        content_length: (.content_length // null),
        redirect_url: (.location // null),
        response_hash: (.hash.body_sha256 // null),
        favicon_hash: (.favicon | if (.==null or .=="") then null else (.|tostring) end),
        tech: ((.tech // []) | map({name:., version:null, category:null, confidence:null})),
        screenshot: ($shots[(.url // "")] // null) }
  ' "$R/httpx.json" > "$R/web_assets.ndjson" 2>/dev/null || true
  _sent "$R/web_assets.ndjson"

  # ── tls.ndjson (httpx tls-grab — home of fingerprint_sha256) ───────────────
  [[ -s "$R/httpx.json" ]] && \
  jq -c --argjson resolved "$RES_MAP" '
    select(.tls != null and ((.tls.fingerprint_hash.sha256 // "") != ""))
    | (.host // "") as $h
    | (($h|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h|test(":"))) as $hisip
    | (if ($h=="" or $hisip) then null else $h end) as $hn
    | { source_module:"STRIP", source_tool:"httpx", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
        ip_at_observation_time: ((.host_ip // ((.a//[])[0]) // "") | if .=="" then null else . end),
        hostname_at_observation_time: $hn,
        hostname_resolvable: (if $hn==null then null else ($resolved[$hn] // false) end),
        port: ((.port // "") | if type=="number" then . elif .=="" then 443 else (tonumber? // 443) end),
        fingerprint_sha256: .tls.fingerprint_hash.sha256,
        subject_cn: (.tls.subject_cn // null),
        subject_sans: (.tls.subject_an // []),
        issuer: (.tls.issuer_cn // .tls.issuer_dn // null),
        not_before: (.tls.not_before // null),
        not_after: (.tls.not_after // null),
        serial_number: (.tls.serial // null),
        key_algorithm: null, key_bits: null, signature_algorithm: null,
        grade: null, issues: [] }
  ' "$R/httpx.json" > "$R/tls.ndjson" 2>/dev/null || true
  _sent "$R/tls.ndjson"

  # ── findings.ndjson (nuclei + testssl, unified §4.5) ───────────────────────
  { [[ -s "$R/nuclei.jsonl" ]] && jq -c -R 'fromjson? | select(.)' "$R/nuclei.jsonl"; } \
  | jq -c --argjson resolved "$RES_MAP" '
      (.host // "") as $h
      | (($h|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h|test(":"))) as $hisip
      | (if ($h=="" or $hisip) then null else $h end) as $hn
      | ( .info.classification["cve-id"] // [] | if type=="array" then . else [.] end ) as $cve
      | ( .info.classification["cwe-id"] // [] | if type=="array" then . else [.] end ) as $cwe
      | ( .info.reference // [] | if type=="array" then . else [.] end ) as $refs
      | { source_module:"STRIP", source_tool:"nuclei", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
          ip_at_observation_time: ((.ip // "") | if .=="" then null else . end),
          hostname_at_observation_time: $hn,
          hostname_resolvable: (if $hn==null then null else ($resolved[$hn] // false) end),
          url: (.url // .["matched-at"] // null),
          port: (.port // null),
          category: (if ($cve|length)>0 then "vulnerability" elif ((.info.severity//"")=="info") then "information" else "exposure" end),
          template_id: (.["template-id"] // .templateID // null),
          cve_id: ($cve[0] // null),
          cwe_id: ($cwe[0] // null),
          title: (.info.name // "unknown"),
          description: (.info.description // null),
          severity: ((.info.severity // .severity // "info")|ascii_downcase),
          cvss_score: (.info.classification["cvss-score"] // null | if type=="string" then (tonumber? // null) else . end),
          cvss_vector: (.info.classification["cvss-metrics"] // null),
          matched_at: (.["matched-at"] // null),
          evidence: (.["matcher-name"] // .matcher_name // null),
          references: $refs, remediation: (.info.remediation // null), raw: . }
  ' > "$R/findings.ndjson" 2>/dev/null || true

  [[ -s "$R/testssl.json" ]] && \
  jq -c --argjson resolved "$RES_MAP" '
    (if type=="object" and has("scanResult") then .scanResult else . end)
    | (if type=="array" then .[] else . end)
    | select(type=="object")
    | ((.ip // "") | tostring | split("/")) as $hi
    | ($hi[0] // "") as $h0
    | (($h0|test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) or ($h0|test(":"))) as $h0isip
    | (($hi|length) > 1 and ($h0isip|not)) as $hasname
    | { source_module:"STRIP", source_tool:"testssl", scan_id:"'"$SCAN_TS"'", observed_at:"'"$SCAN_TS"'",
        ip_at_observation_time: (($hi[-1] // "") | if .=="" then null else . end),
        hostname_at_observation_time: (if $hasname then $h0 else null end),
        hostname_resolvable: (if $hasname then ($resolved[$h0] // false) else null end),
        url: null,
        port: ((.port // null) | if type=="string" then (tonumber? // null) else . end),
        category: "weak_tls",
        template_id: (.id // null),
        cve_id: (.cve // null),
        cwe_id: null,
        title: (.id // .finding // "tls_issue"),
        description: (.finding // null),
        severity: ((.severity // "info")|ascii_downcase),
        cvss_score: null, cvss_vector: null, matched_at: null,
        evidence: (.finding // null),
        references: [], remediation: null, raw: . }
    | select(.severity | IN("low","medium","high","critical"))
  ' "$R/testssl.json" >> "$R/findings.ndjson" 2>/dev/null || true
  # email-posture findings (absences/weaknesses) — appended before the sentinel check
  sp_email_posture "$R" >> "$R/findings.ndjson" 2>/dev/null || true
  # subdomain-takeover findings (confirmed|potential) from the CNAME candidates + nuclei takeover pass
  sp_takeover_findings "$R" >> "$R/findings.ndjson" 2>/dev/null || true
  _sent "$R/findings.ndjson"

  # ── CSV summaries (lossy convenience; NDJSON is the contract) ──────────────
  [[ -s "$R/hosts.ndjson" ]]      && jq -r 'select(has("message")|not)|[.ip_at_observation_time,.is_private,.ptr_record,.asn,.mac]|@csv' "$R/hosts.ndjson" > "$R/hosts.csv" 2>/dev/null || true
  [[ -s "$R/services.ndjson" ]]   && jq -r 'select(has("message")|not)|[(.hostname_at_observation_time // .ip_at_observation_time),.port,.protocol,.service,.product,.version]|@csv' "$R/services.ndjson" > "$R/open_ports.csv" 2>/dev/null || true
  [[ -s "$R/web_assets.ndjson" ]] && jq -r 'select(has("message")|not)|[.url,(.hostname_at_observation_time // .ip_at_observation_time),.status,.title,.server]|@csv' "$R/web_assets.ndjson" > "$R/web_assets.csv" 2>/dev/null || true
  [[ -s "$R/tls.ndjson" ]]        && jq -r 'select(has("message")|not)|[(.hostname_at_observation_time // .ip_at_observation_time),.port,.fingerprint_sha256,.subject_cn,.not_after]|@csv' "$R/tls.ndjson" > "$R/tls.csv" 2>/dev/null || true
  [[ -s "$R/findings.ndjson" ]]   && jq -r 'select(has("message")|not)|[(.hostname_at_observation_time // .ip_at_observation_time),.url,.severity,.category,(.cve_id // .template_id),.source_tool]|@csv' "$R/findings.ndjson" > "$R/findings_summary.csv" 2>/dev/null || true

  manifest "$R"
  log "[✓] Merge complete — 6 NDJSON streams + run_manifest.json written to $R"
}

usage(){
  cat <<USAGE
STRIP v$STRIP_VERSION — Surface Threat Reconnaissance & Identification Platform

Setup (first time only):
  stripctl setup                  # Download Nuclei templates to Docker volume

Discovery & Scanning:
  stripctl discover               # Full reconnaissance (subdomains → DNS → ports → HTTP)
  stripctl run daily              # Complete daily scan (discover + nuclei + screenshots)
  stripctl run weekly             # Comprehensive weekly scan (includes medium severity)

Additional:
  stripctl merge [run-dir]        # Normalize a run into sensor-output/1.0 (default: latest populated run)
  stripctl version                # Print the STRIP version

Examples:
  # First time setup (optional - auto-runs if templates missing)
  ./stripctl setup

  # Discover targets
  ./stripctl discover

  # Daily monitoring scan
  ./stripctl run daily

  # Weekly comprehensive scan
  ./stripctl run weekly

Output: data/out/YYYYMMDD-HHMMSS/

Notes:
  - Templates stored securely in Docker volume (not on host filesystem)
  - Templates auto-download on first 'run daily' or 'run weekly' if missing
  - 'discover' can be run standalone for manual analysis
  - 'run daily/weekly' includes full workflow (discover + scan + screenshots)
USAGE
}

# CLI dispatch — skipped when sourced for tests (STRIP_TEST_MODE=1) so `source stripctl` starts no scan
if [[ "${STRIP_TEST_MODE:-0}" != "1" ]]; then
case "${1:-}" in
  setup)
    setup
    ;;
  discover) 
    discover 
    ;;
  run)
    case "${2:-}" in
      daily)  
        PROFILE=daily
        ensure_nuclei_templates
        discover
        webscan "$(yqg '.scan.nuclei.severity_daily')"
        tls
        shots
        email
        takeover
        merge
        ;;
      weekly)
        PROFILE=weekly
        ensure_nuclei_templates
        discover sweep
        webscan "$(yqg '.scan.nuclei.severity_weekly')"
        tls
        shots
        email
        takeover
        merge
        ;;
      *) 
        usage 
        ;;
    esac 
    ;;
  merge)
    # standalone merge: normalize an explicit run dir ($2) or the latest populated one — never the
    # fresh empty dir this invocation just created (that would only write "no records" sentinels)
    rmdir "$OUT" 2>/dev/null || true    # discard the unused empty startup dir
    if [[ -n "${2:-}" ]]; then
      [[ -d "$2" ]] || { echo "No such run dir: $2"; exit 1; }
      OUT="${2%/}"
    else
      OUT="$(latest_run_dir)" || { echo "No populated run dir under $STRIP_HOME/${OUTROOT#./} — run 'discover' first"; exit 1; }
      log "merge: using latest populated run dir → $OUT"
    fi
    TS="$(basename "$OUT")"    # keep container paths (/data/out/$TS/…) pointed at the resolved run dir
    # rebuild the ISO scan_id from the run-dir timestamp so re-merging a run yields the SAME scan_id
    # (and observed_at) as the original discovery — not a fresh merge-time id
    if [[ "$TS" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})$ ]]; then
      SCAN_TS="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}Z"
    fi
    merge
    ;;
  *) 
    usage 
    ;;
esac
fi
